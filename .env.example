# Copy to catch/.env (untracked) for `npm run local` and `npm run server`.
# Names only; the values live in the password manager.
DEEPGRAM_API_KEY=
CATCH_AUDIO_TOKEN=
GEMINI_API_KEY=
# Optional: CATCH_SPLIT (loudness | speaker-role | provider-labels), CATCH_LOUDNESS_THRESHOLD_DBFS, PORT, CATCH_DB
# CATCH_LOUDNESS_THRESHOLD_DBFS: unset, the server uses -20 and `npm run local` -25 (a laptop mic)
# Optional: CATCH_THREAD_DETECTION (on | off; on when unset): off is D120's tap fallback for the dropped thread
# Optional: CATCH_PAUSE (on | off; off when unset, and in the demo build): on, a swipe down at the dot pauses Catch (P6, D86)
# Optional: the wearer's name, never caught whatever the split decides
CATCH_WEARER_NAME=
# Optional: the wearer's time zone (e.g. America/Los_Angeles), for a kept notification with no name caught; the server's own when unset
CATCH_TIME_ZONE=
# Optional, the readability pass (tunable on the glasses without a new package):
# CATCH_LENS_BRIGHTNESS (0..4), CATCH_DOT_X, CATCH_DOT_Y (pixels on the 576x288 canvas)
# CATCH_KEYTERMS (comma list of words Deepgram should listen for, e.g. the names you expect)
