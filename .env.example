# Copy to catch/.env (untracked) for `npm run local` and `npm run server`.
# Names only; the values live in the password manager.
DEEPGRAM_API_KEY=
CATCH_AUDIO_TOKEN=
GEMINI_API_KEY=
# Optional: CATCH_SPLIT (loudness | speaker-role | provider-labels), CATCH_LOUDNESS_THRESHOLD_DBFS, PORT, CATCH_DB
# Optional: the wearer's name, never caught whatever the split decides
CATCH_WEARER_NAME=
